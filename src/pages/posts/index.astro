---
/**
 * posts/index.astro — Blog Feed Page (/posts/)
 * Markdown blog managed entirely via Git commits.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Get non-draft posts on production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Collect all unique categories and tags
const allCategories = ['All', ...new Set(sortedPosts.map((p) => p.data.category))];
const allTags = [...new Set(sortedPosts.flatMap((p) => p.data.tags))];
---

<BaseLayout
  title="Posts & Notes — Trần Vĩnh Thịnh"
  description="Ghi chép học tập, bài viết kỹ thuật và kinh nghiệm lập trình của Trần Vĩnh Thịnh."
>
  <div class="posts-page-container">
    <div class="container">
      <!-- Header -->
      <header class="page-header scroll-reveal">
        <span class="section-label">// KNOWLEDGE_TRANSMISSIONS</span>
        <h1 class="page-title">Notes from my digital journey</h1>
        <p class="page-desc">
          Tập hợp các bài viết chia sẻ quá trình học lập trình, thử nghiệm công nghệ và ghi chú hệ thống. Xuất bản hoàn toàn tự động bằng Markdown và Git commit.
        </p>

        <!-- Search & Filter Controls -->
        <div class="search-filter-wrapper glass-panel">
          <!-- Search input -->
          <div class="search-input-box">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              class="search-input"
              placeholder="Tìm kiếm bài viết theo từ khóa, tiêu đề..."
              aria-label="Tìm kiếm bài viết"
            />
            <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Xóa tìm kiếm" style="display: none;">
              ✕
            </button>
          </div>

          <!-- Category filter tabs -->
          <div class="category-tabs" role="tablist" aria-label="Bộ lọc chuyên mục bài viết">
            {allCategories.map((cat, idx) => (
              <button
                type="button"
                class={`category-tab ${idx === 0 ? 'active' : ''}`}
                data-category={cat}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Popular Tags Pill Cloud -->
          {allTags.length > 0 && (
            <div class="tag-cloud">
              <span class="tag-cloud-label">Tags:</span>
              {allTags.map((tag) => (
                <button type="button" class="tag-pill" data-tag={tag}>
                  #{tag}
                </button>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Post Feed Grid -->
      <div class="posts-grid" id="posts-grid">
        {sortedPosts.map((post) => {
          const searchableText = `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase();
          return (
            <div
              class="post-item"
              data-category={post.data.category}
              data-tags={post.data.tags.join(',')}
              data-search={searchableText}
            >
              <PostCard post={post} />
            </div>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="no-posts-found" class="empty-state glass-panel" style="display: none;">
        <div class="empty-glyph">✧</div>
        <h3>Không tìm thấy bài viết phù hợp</h3>
        <p>Thử tìm với từ khóa khác hoặc xóa bộ lọc để hiển thị toàn bộ bài viết.</p>
        <button type="button" id="reset-filter-btn" class="btn btn-outline mt-3">
          Hiển thị tất cả bài viết
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .posts-page-container {
    padding-top: 3.5rem;
    padding-bottom: 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.85rem;
  }

  .page-desc {
    max-width: 680px;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* Search & Filter Panel */
  .search-filter-wrapper {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-dim);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.85rem 2.75rem 0.85rem 2.85rem;
    background: rgba(8, 12, 28, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-size: 0.95rem;
    font-family: inherit;
    transition: all var(--transition-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(126, 232, 250, 0.2);
  }

  .clear-btn {
    position: absolute;
    right: 1rem;
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.95rem;
  }

  .clear-btn:hover {
    color: var(--text-main);
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-tab {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .category-tab:hover {
    color: var(--text-main);
    border-color: var(--border-glow);
  }

  .category-tab.active {
    background: rgba(126, 232, 250, 0.12);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tag-cloud-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-right: 0.25rem;
  }

  .tag-pill {
    background: rgba(184, 169, 232, 0.08);
    border: 1px solid rgba(184, 169, 232, 0.2);
    color: var(--accent-lavender);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-pill:hover,
  .tag-pill.active {
    background: rgba(184, 169, 232, 0.2);
    border-color: var(--accent-lavender);
    color: #ffffff;
  }

  /* Feed Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-item {
    transition: opacity 0.3s ease;
  }

  /* Empty State */
  .empty-state {
    padding: 4.5rem 2rem;
    text-align: center;
    border-radius: var(--radius-md);
    margin-top: 2rem;
  }

  .empty-glyph {
    font-size: 3rem;
    color: var(--accent-lavender);
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--text-muted);
  }

  .mt-3 {
    margin-top: 1.5rem;
  }
</style>

<script>
  (() => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const categoryTabs = document.querySelectorAll('.category-tab');
    const tagPills = document.querySelectorAll('.tag-pill');
    const postItems = document.querySelectorAll<HTMLElement>('.post-item');
    const emptyState = document.getElementById('no-posts-found');
    const resetBtn = document.getElementById('reset-filter-btn');

    let activeCategory = 'All';
    let activeTag = '';
    let searchQuery = '';

    const applyFilters = () => {
      let visible = 0;

      postItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemTags = (item.getAttribute('data-tags') || '').split(',');
        const itemSearch = item.getAttribute('data-search') || '';

        const matchesCat = activeCategory === 'All' || itemCat === activeCategory;
        const matchesTag = !activeTag || itemTags.includes(activeTag);
        const matchesSearch = !searchQuery || itemSearch.includes(searchQuery);

        if (matchesCat && matchesTag && matchesSearch) {
          item.style.display = 'block';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visible === 0 ? 'block' : 'none';
      }
    };

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = searchQuery ? 'block' : 'none';
        }
        applyFilters();
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchQuery = '';
          clearBtn.style.display = 'none';
          applyFilters();
        });
      }
    }

    // Category Tabs listener
    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        activeCategory = tab.getAttribute('data-category') || 'All';
        applyFilters();
      });
    });

    // Tag pills listener
    tagPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-tag') || '';
        if (activeTag === tag) {
          activeTag = '';
          pill.classList.remove('active');
        } else {
          tagPills.forEach((p) => p.classList.remove('active'));
          activeTag = tag;
          pill.classList.add('active');
        }
        applyFilters();
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
        }
        if (clearBtn) clearBtn.style.display = 'none';
        activeCategory = 'All';
        activeTag = '';
        categoryTabs.forEach((t, i) => {
          t.classList.toggle('active', i === 0);
          t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        });
        tagPills.forEach((p) => p.classList.remove('active'));
        applyFilters();
      });
    }
  })();
</script>
