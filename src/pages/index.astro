---
/**
 * index.astro — Home Page (/)
 * Art direction: Dreamcore × AI
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AIOrb from '../components/AIOrb.astro';
import Terminal from '../components/Terminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig, resolveUrl } from '../data/site';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

// Fetch latest blog posts, filtering out drafts in production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// Sort descending by pubDate
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);

// Featured projects
const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
---

<BaseLayout>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Eyebrow Badge -->
        <div class="hero-eyebrow">
          <span class="eyebrow-ping"></span>
          <span class="eyebrow-text">{siteConfig.headline}</span>
        </div>

        <!-- Main Title -->
        <h1 class="hero-title">
          Xin chào, mình là <br />
          <span class="name-gradient">{siteConfig.shortName}</span>
        </h1>

        <!-- Subtitle & Rotating Typing Text -->
        <div class="hero-subline">
          <p class="hero-subtitle">{siteConfig.subtitle}</p>
          <div class="typing-container">
            <span class="typing-prefix">> </span>
            <span id="rotating-text" class="rotating-text">{siteConfig.rotatingTexts[0]}</span>
            <span class="typing-caret" aria-hidden="true">|</span>
          </div>
        </div>

        <!-- Bio short -->
        <p class="hero-bio">
          {siteConfig.bioShort}
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions">
          <a href={resolveUrl('/projects/')} class="btn btn-primary">
            <span>Khám phá Dự án</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>
          <a href={resolveUrl('/posts/')} class="btn btn-outline">
            <span>Đọc Ghi chú của mình</span>
          </a>
        </div>
      </div>

      <!-- Hero Visual: AI Orb + Floating Energy -->
      <div class="hero-visual">
        <AIOrb size="lg" />
      </div>
    </div>
  </section>

  <!-- 2. TERMINAL SHOWCASE SECTION -->
  <section class="section terminal-section scroll-reveal">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">// SYSTEM_DIAGNOSTICS</span>
        <h2 class="section-title">Không gian kỹ thuật số</h2>
        <p class="section-desc">
          Mô phỏng bảng điều khiển định danh, hiển thị trạng thái học tập và lĩnh vực nghiên cứu hiện tại.
        </p>
      </div>

      <div class="terminal-center-wrapper">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- 3. FEATURED PROJECTS SECTION -->
  <section class="section projects-section scroll-reveal">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="section-label">// SELECTED_WORKS</span>
          <h2 class="section-title">Dự án tiêu biểu</h2>
          <p class="section-desc">
            Các sản phẩm thực hành và đồ án học tập mình đã và đang xây dựng.
          </p>
        </div>
        <a href={resolveUrl('/projects/')} class="view-all-link">
          <span>Xem tất cả dự án</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 5"></polyline>
          </svg>
        </a>
      </div>

      <div class="cards-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. LATEST POSTS SECTION -->
  <section class="section posts-section scroll-reveal">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="section-label">// DIGITAL_NOTES</span>
          <h2 class="section-title">Bài viết mới nhất</h2>
          <p class="section-desc">
            Nhật ký và những bài học được quản lý trực tiếp bằng Markdown qua Git commit.
          </p>
        </div>
        <a href={resolveUrl('/posts/')} class="view-all-link">
          <span>Xem tất cả bài viết</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 5"></polyline>
          </svg>
        </a>
      </div>

      <div class="cards-grid">
        {latestPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CONTACT CTA BANNER -->
  <section class="section cta-section scroll-reveal">
    <div class="container">
      <div class="cta-banner glass-panel">
        <div class="cta-content">
          <span class="section-label">// OPEN_TRANSMISSION</span>
          <h2 class="cta-title">Bạn có ý tưởng hoặc muốn kết nối?</h2>
          <p class="cta-desc">
            Mình luôn sẵn sàng trao đổi về công nghệ web, trí tuệ nhân tạo hoặc các dự án học tập cùng bạn.
          </p>
        </div>
        <div class="cta-button-group">
          <a href={resolveUrl('/contact/')} class="btn btn-primary">
            <span>Ghé thăm trang Contact</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 5"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.25fr 0.85fr;
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(126, 232, 250, 0.08);
    border: 1px solid rgba(126, 232, 250, 0.22);
    margin-bottom: 1.5rem;
  }

  .eyebrow-ping {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: pulseGlow 2s infinite;
  }

  .eyebrow-text {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    color: var(--accent-cyan);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    font-weight: 800;
  }

  .name-gradient {
    background: linear-gradient(135deg, #ffffff 10%, #7ee8fa 50%, #b8a9e8 90%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-subline {
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: #e2e8f0;
    margin-bottom: 0.4rem;
    font-weight: 500;
  }

  .typing-container {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent-lavender);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.6rem;
  }

  .typing-prefix {
    color: var(--accent-cyan);
    font-weight: bold;
  }

  .rotating-text {
    color: #93c5fd;
  }

  .typing-caret {
    animation: blink 0.8s infinite;
    color: var(--accent-cyan);
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* General Section Spacing */
  .section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .text-center {
    text-align: center;
  }

  .text-center .section-desc {
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-center-wrapper {
    display: flex;
    justify-content: center;
  }

  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--accent-cyan);
    transition: transform var(--transition-fast);
  }

  .view-all-link:hover {
    transform: translateX(4px);
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* CTA Banner */
  .cta-banner {
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-glow);
    background: linear-gradient(135deg, rgba(14, 20, 46, 0.85), rgba(20, 30, 68, 0.75));
  }

  @media (min-width: 860px) {
    .cta-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 3.5rem 3rem;
    }
  }

  .cta-title {
    font-size: clamp(1.75rem, 3.5vw, 2.2rem);
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    max-width: 580px;
  }

  .cta-button-group {
    flex-shrink: 0;
  }

  @keyframes blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  (() => {
    const el = document.getElementById('rotating-text');
    if (!el) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const phrases = [
      'Building digital experiences',
      'Exploring Artificial Intelligence',
      'Learning, creating, evolving',
      'Venturing through liminal code',
    ];

    let phraseIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    const typeSpeed = 70;
    const deleteSpeed = 35;
    const pauseEnd = 2400;

    const tick = () => {
      const current = phrases[phraseIdx];

      if (isDeleting) {
        charIdx--;
        el.textContent = current.substring(0, charIdx);
      } else {
        charIdx++;
        el.textContent = current.substring(0, charIdx);
      }

      let speed = isDeleting ? deleteSpeed : typeSpeed;

      if (!isDeleting && charIdx === current.length) {
        isDeleting = true;
        speed = pauseEnd;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        speed = 500;
      }

      setTimeout(tick, speed);
    };

    tick();
  })();
</script>
