---
/**
 * contact.astro — Contact Page (/contact/)
 * Art direction: Connection nodes, Dreamcore portal, honest interaction.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, isPlaceholderUrl } from '../data/site';

const isEmailPlaceholder = isPlaceholderUrl(siteConfig.socials.email);
const isGithubPlaceholder = isPlaceholderUrl(siteConfig.socials.github);
const isLinkedinPlaceholder = isPlaceholderUrl(siteConfig.socials.linkedin);
---

<BaseLayout
  title="Contact — Trần Vĩnh Thịnh"
  description="Liên hệ và kết nối với Trần Vĩnh Thịnh qua Email, GitHub hoặc LinkedIn."
>
  <div class="contact-page-container">
    <div class="container">
      <!-- Page Header -->
      <header class="page-header scroll-reveal">
        <span class="section-label">// TRANSMISSION_CHANNELS</span>
        <h1 class="page-title">Let's connect</h1>
        <p class="page-desc">
          Rất vui được kết nối cùng bạn! Dù bạn muốn trao đổi về bài tập công nghệ, cơ hội thực tập, thảo luận về Web & AI hay đơn giản là chào nhau, đừng ngần ngại gửi tin nhắn.
        </p>
      </header>

      <div class="contact-grid">
        <!-- Col 1: Connection Cards & Portal -->
        <div class="contact-channels scroll-reveal">
          <!-- Email Card -->
          <div class="channel-card glass-panel">
            <div class="channel-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="channel-details">
              <h3>Hộp thư điện tử</h3>
              <p class="channel-note">Kênh liên lạc trực tiếp và phản hồi nhanh nhất.</p>

              {isEmailPlaceholder ? (
                <div class="placeholder-notice">
                  <span class="placeholder-text">{siteConfig.socials.email}</span>
                  <span class="placeholder-tag">Placeholder — Cập nhật trong src/data/site.ts</span>
                </div>
              ) : (
                <div class="channel-action">
                  <a href={`mailto:${siteConfig.socials.email}`} class="channel-link">
                    {siteConfig.socials.email}
                  </a>
                  <button type="button" id="copy-email-btn" class="btn btn-outline btn-sm" data-email={siteConfig.socials.email}>
                    Copy Email
                  </button>
                </div>
              )}
            </div>
          </div>

          <!-- GitHub Card -->
          <div class="channel-card glass-panel">
            <div class="channel-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </div>
            <div class="channel-details">
              <h3>GitHub</h3>
              <p class="channel-note">Xem các repository mã nguồn và dự án mình đang thực hiện.</p>

              {isGithubPlaceholder ? (
                <div class="placeholder-notice">
                  <span class="placeholder-text">{siteConfig.socials.github}</span>
                  <span class="placeholder-tag">Placeholder — Cập nhật trong src/data/site.ts</span>
                </div>
              ) : (
                <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="channel-link">
                  Ghé thăm trang GitHub ↗
                </a>
              )}
            </div>
          </div>

          <!-- LinkedIn Card -->
          <div class="channel-card glass-panel">
            <div class="channel-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </div>
            <div class="channel-details">
              <h3>LinkedIn</h3>
              <p class="channel-note">Hồ sơ học tập và mạng lưới kết nối nghề nghiệp.</p>

              {isLinkedinPlaceholder ? (
                <div class="placeholder-notice">
                  <span class="placeholder-text">{siteConfig.socials.linkedin}</span>
                  <span class="placeholder-tag">Placeholder — Cập nhật trong src/data/site.ts</span>
                </div>
              ) : (
                <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="channel-link">
                  Kết nối qua LinkedIn ↗
                </a>
              )}
            </div>
          </div>

          <!-- Location Info Card -->
          <div class="channel-card glass-panel">
            <div class="channel-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="channel-details">
              <h3>Khu vực hoạt động</h3>
              <p class="channel-value">{siteConfig.location}</p>
              <p class="channel-note">Múi giờ UTC+7 (Indochina Time) · Sẵn sàng làm việc Remote hoặc On-site.</p>
            </div>
          </div>
        </div>

        <!-- Col 2: Transparent Mock Form & Mailto Fallback -->
        <div class="contact-form-wrapper scroll-reveal">
          <div class="contact-form-panel glass-panel">
            <div class="form-header">
              <span class="badge badge-lavender">Direct Dispatch</span>
              <h2>Gửi thư cho Thịnh</h2>
              <p class="form-disclaimer">
                Trang web tĩnh này không có backend hay database thu thập thông tin cá nhân. Nhấn nút gửi sẽ mở trực tiếp ứng dụng email (mailto) của bạn để gửi thư an toàn.
              </p>
            </div>

            <form id="contact-form" class="direct-form" data-recipient-email={siteConfig.socials.email}>
              <div class="form-group">
                <label for="sender-name">Họ và tên của bạn</label>
                <input type="text" id="sender-name" name="name" placeholder="Nguyễn Văn A" required />
              </div>

              <div class="form-group">
                <label for="sender-subject">Tiêu đề tin nhắn</label>
                <input type="text" id="sender-subject" name="subject" placeholder="Chào Thịnh, mình muốn trao đổi về..." required />
              </div>

              <div class="form-group">
                <label for="sender-message">Nội dung</label>
                <textarea id="sender-message" name="message" rows="5" placeholder="Viết vài dòng chia sẻ tại đây..." required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full">
                <span>Soạn thư qua Email Client (mailto)</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page-container {
    padding-top: 3.5rem;
    padding-bottom: 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.85rem;
  }

  .page-desc {
    max-width: 680px;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* Grid Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .channel-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-md);
  }

  .channel-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(126, 232, 250, 0.08);
    border: 1px solid rgba(126, 232, 250, 0.2);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-details {
    flex-grow: 1;
  }

  .channel-details h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .channel-note {
    font-size: 0.875rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .channel-value {
    font-size: 1rem;
    color: #ffffff;
    font-weight: 500;
  }

  .channel-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-cyan);
    display: inline-block;
  }

  .channel-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
  }

  .placeholder-notice {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .placeholder-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .placeholder-tag {
    font-size: 0.72rem;
    color: #fbbf24;
    font-style: italic;
  }

  /* Form Styling */
  .contact-form-panel {
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
  }

  .form-header {
    margin-bottom: 1.75rem;
  }

  .form-header h2 {
    font-size: 1.65rem;
    margin-top: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .form-disclaimer {
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .direct-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.85rem 1rem;
    background: rgba(8, 12, 28, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-size: 0.95rem;
    font-family: inherit;
    transition: all var(--transition-fast);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(126, 232, 250, 0.2);
  }

  .btn-full {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>

<script>
  (() => {
    // 1. Copy email button
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'Đã sao chép!';
          setTimeout(() => {
            copyBtn.textContent = originalText;
          }, 2000);
        } catch (err) {
          console.error('Không thể copy email:', err);
        }
      });
    }

    // 2. Direct Form to Mailto
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameEl = document.getElementById('sender-name') as HTMLInputElement | null;
        const subjectEl = document.getElementById('sender-subject') as HTMLInputElement | null;
        const msgEl = document.getElementById('sender-message') as HTMLTextAreaElement | null;

        const name = nameEl?.value || '';
        const subject = subjectEl?.value || 'Liên hệ từ Portfolio';
        const msg = msgEl?.value || '';

        const recipientEmail = form.getAttribute('data-recipient-email') || 'thinhtran.260520@gmail.com';
        const fullBody = `Chào Vĩnh Thịnh,\n\n${msg}\n\n---\nNgười gửi: ${name}`;
        const mailtoUrl = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullBody)}`;

        window.location.href = mailtoUrl;
      });
    }
  })();
</script>
