---
/**
 * PostCard.astro
 * Card component for displaying a blog post summary in the feed.
 */
import { resolveUrl } from '../data/site';

interface Props {
  post: {
    id: string;
    slug?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags: string[];
      draft?: boolean;
    };
    body?: string;
  };
}

const { post } = Astro.props;
const slug = post.slug || post.id;
const postUrl = resolveUrl(`/posts/${slug}/`);

// Approximate reading time (average 200 words per minute)
const wordCount = post.body ? post.body.split(/\s+/).length : 500;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Format date in Vietnamese locale
const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(new Date(post.data.pubDate));
---

<article class="post-card glass-panel">
  <div class="post-card-inner">
    <!-- Meta Header -->
    <div class="post-meta">
      <span class="badge badge-lavender">{post.data.category}</span>
      <span class="meta-separator">•</span>
      <time datetime={new Date(post.data.pubDate).toISOString()} class="post-date">
        {formattedDate}
      </time>
      <span class="meta-separator">•</span>
      <span class="post-read-time">{readingTime} phút đọc</span>
    </div>

    <!-- Post Title -->
    <h3 class="post-title">
      <a href={postUrl} class="post-title-link">
        {post.data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="post-desc">{post.data.description}</p>

    <!-- Footer: Tags & Read more link -->
    <div class="post-card-footer">
      <div class="post-tags">
        {post.data.tags.slice(0, 3).map((tag: string) => (
          <span class="tag-item">#{tag}</span>
        ))}
      </div>

      <a href={postUrl} class="read-more-link" aria-label={`Đọc bài viết: ${post.data.title}`}>
        <span>Đọc bài</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .post-card:hover {
    transform: translateY(-3px);
  }

  .post-card-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.785rem;
    color: var(--text-dim);
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .meta-separator {
    opacity: 0.4;
  }

  .post-date,
  .post-read-time {
    color: var(--text-dim);
  }

  .post-title {
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
    line-height: 1.4;
  }

  .post-title-link {
    color: #ffffff;
    transition: color var(--transition-fast);
  }

  .post-title-link:hover {
    color: var(--accent-cyan);
    text-shadow: 0 0 10px rgba(126, 232, 250, 0.4);
  }

  .post-desc {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post-card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-item {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-lavender);
    opacity: 0.85;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-left: auto;
  }

  .read-more-link:hover {
    color: #ffffff;
    transform: translateX(2px);
  }
</style>
