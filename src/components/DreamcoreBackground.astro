---
/**
 * DreamcoreBackground.astro
 * Layered atmospheric haze, ethereal gradients, perspective digital grid,
 * and lightweight canvas particle/star node field with reduced-motion fallback.
 */
---

<div class="dreamcore-viewport" aria-hidden="true">
  <!-- Multi-layered Atmospheric Volumetric Glows -->
  <div class="haze-layer haze-1"></div>
  <div class="haze-layer haze-2"></div>
  <div class="haze-layer haze-3"></div>

  <!-- Perspective Liminal Digital Grid -->
  <div class="liminal-grid"></div>

  <!-- Ambient Canvas Particles & Constellation Nodes -->
  <canvas id="dreamcore-canvas" class="dreamcore-canvas"></canvas>

  <!-- High-contrast legibility veil -->
  <div class="legibility-veil"></div>
</div>

<style>
  .dreamcore-viewport {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
    background-color: var(--bg-deep);
  }

  /* Deep Volumetric Haze Layers */
  .haze-layer {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    will-change: transform, opacity;
  }

  .haze-1 {
    top: -15%;
    left: -10%;
    width: 65vw;
    height: 65vw;
    background: radial-gradient(circle, rgba(143, 101, 226, 0.28) 0%, rgba(14, 19, 41, 0) 70%);
    animation: driftSlow 32s ease-in-out infinite alternate;
  }

  .haze-2 {
    bottom: -20%;
    right: -10%;
    width: 75vw;
    height: 75vw;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.22) 0%, rgba(126, 232, 250, 0.12) 40%, rgba(6, 9, 19, 0) 75%);
    animation: driftSlow 40s ease-in-out infinite alternate-reverse;
  }

  .haze-3 {
    top: 35%;
    left: 25%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, rgba(184, 169, 232, 0.15) 0%, rgba(6, 9, 19, 0) 65%);
    animation: pulseAtmosphere 22s ease-in-out infinite alternate;
  }

  /* Perspective Digital Horizon Grid */
  .liminal-grid {
    position: absolute;
    bottom: 0;
    left: -50%;
    width: 200%;
    height: 60vh;
    background-image: 
      linear-gradient(rgba(126, 232, 250, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(143, 101, 226, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    transform: perspective(600px) rotateX(65deg) translateY(20%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 90%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 90%);
    pointer-events: none;
    opacity: 0.65;
  }

  /* Canvas Particle Overlay */
  .dreamcore-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.75;
  }

  /* Legibility Veil (keeps foreground content crystal clear) */
  .legibility-veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 0%, rgba(6, 9, 19, 0.45) 80%);
    pointer-events: none;
  }

  @keyframes driftSlow {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(6vw, 4vh) scale(1.12);
    }
  }

  @keyframes pulseAtmosphere {
    0% {
      opacity: 0.1;
      transform: scale(0.95);
    }
    100% {
      opacity: 0.35;
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .haze-layer {
      animation: none !important;
      opacity: 0.25;
    }
    .liminal-grid {
      opacity: 0.3;
    }
    .dreamcore-canvas {
      display: none;
    }
  }
</style>

<script>
  // Lightweight canvas particle constellation with auto-throttle and visibility check
  (() => {
    const canvas = document.getElementById('dreamcore-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Respect user motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId: number;
    let isTabVisible = true;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      alpha: number;
      color: string;
    }

    const particles: Particle[] = [];
    const colors = ['#7ee8fa', '#b8a9e8', '#8f65e2', '#38bdf8'];

    const resize = () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initParticles();
    };

    const initParticles = () => {
      particles.length = 0;
      // Adjust density based on screen size (less on mobile)
      const particleCount = Math.min(Math.floor((width * height) / 22000), 55);
      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
          radius: Math.random() * 1.8 + 0.6,
          alpha: Math.random() * 0.5 + 0.2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
    };

    const render = () => {
      if (!isTabVisible) return;

      ctx.clearRect(0, 0, width, height);

      // Draw connection lines
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            const lineAlpha = (1 - dist / 110) * 0.15;
            ctx.beginPath();
            ctx.strokeStyle = `rgba(126, 232, 250, ${lineAlpha})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }

      // Draw and update particles
      for (const p of particles) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.alpha;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 6;
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1;

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;
      }

      animationFrameId = requestAnimationFrame(render);
    };

    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => {
      isTabVisible = !document.hidden;
      if (isTabVisible) {
        animationFrameId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animationFrameId);
      }
    });

    resize();
    render();
  })();
</script>
