---
/**
 * ThemeToggle.astro
 * Accessible theme switcher with local storage persistence.
 * Dark/Midnight is the default dreamcore mode.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle-btn"
  aria-label="Chuyển đổi giao diện sáng/tối"
  title="Chuyển đổi giao diện"
>
  <span class="theme-icon icon-moon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
  <span class="theme-icon icon-sun" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
</button>

<style>
  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: rgba(14, 19, 41, 0.7);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
  }

  .theme-toggle-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    box-shadow: 0 0 12px rgba(126, 232, 250, 0.25);
  }

  .theme-icon {
    display: none;
  }

  /* Default dark mode shows moon */
  :global(:root:not([data-theme="dream-light"])) .icon-moon {
    display: block;
  }

  /* Light mode shows sun */
  :global([data-theme="dream-light"]) .icon-sun {
    display: block;
    color: #fbbf24;
  }
</style>

<script>
  (() => {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    const getStoredTheme = () => {
      return localStorage.getItem('thinh_portfolio_theme') || 'dark';
    };

    const setTheme = (theme: string) => {
      if (theme === 'dream-light') {
        document.documentElement.setAttribute('data-theme', 'dream-light');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      localStorage.setItem('thinh_portfolio_theme', theme);
    };

    // Apply stored theme on load
    setTheme(getStoredTheme());

    toggleBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') === 'dream-light' ? 'dream-light' : 'dark';
      const next = current === 'dark' ? 'dream-light' : 'dark';
      setTheme(next);
    });
  })();
</script>
